<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>VPet.Mod.LLMChat</RootNamespace>
		<AssemblyName>VPet.Mod.LLMChat</AssemblyName>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<!--
			OutputType=LibraryのSDKプロジェクトは既定でNuGetパッケージの依存DLLを出力にコピーしないため、
			MODとして本体プロセスにロードされるこのプロジェクトではNAudio等の依存を確実に同梱するよう有効化する
		-->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<AssemblyTitle>LLM Chat (Claude / ChatGPT / DeepSeek)</AssemblyTitle>
		<Description>VPet MOD: キャラクターとClaude/ChatGPT/DeepSeek等のLLMで会話する</Description>
		<Product>VPet.Mod.LLMChat</Product>
	</PropertyGroup>

	<ItemGroup>
		<!-- 本体側で既にロード済みのアセンブリを利用するため出力にはコピーしない -->
		<ProjectReference Include="..\VPet-Simulator.Core\VPet-Simulator.Core.csproj" Private="false" />
		<ProjectReference Include="..\VPet-Simulator.Windows.Interface\VPet-Simulator.Windows.Interface.csproj" Private="false" />
		<!--
			A.I.VOICE連携用の仲介プロセス(net48、AiVoiceClientが実行時に外部プロセスとして起動する)。
			本体からAPIとして参照はしないためReferenceOutputAssembly=falseとし、ビルド順序の連携のみ行う。
			成果物のexeは自身のDeployToModFolderターゲットでこのMODと同じpluginフォルダへ配置される。
		-->
		<ProjectReference Include="..\VPet.Mod.LLMChat.AiVoiceBridge\VPet.Mod.LLMChat.AiVoiceBridge.csproj" ReferenceOutputAssembly="false" />
		<!--
			本体がNAudioを参照しているとはいえ、WaveInEvent等が含まれるNAudio.WinMM.dllは
			本体の通常動作では実際にロードされないことがあるため、確実に動くようこのMOD自身の
			plugin フォルダにも同梱する(Private=true、既定値のため明示指定なし)
		-->
		<PackageReference Include="NAudio" Version="2.2.1" />
	</ItemGroup>

	<!--
		ビルド成果物をVPet本体のmodフォルダへ配置する。
		mklink.batが作るはずのシンボリックリンク(bin\...\mod -> ソースのmodフォルダ)が
		存在しない/機能していない環境では、本体の実行ファイルが読みに行く
		bin\<Platform>\<Configuration>\net8.0-windows\mod\ が実体の伴わない別フォルダになるため、
		念のためソースツリーと主要なビルド出力先の両方へ直接コピーする。
	-->
	<PropertyGroup>
		<ModName>1200_LLMChat</ModName>
		<SourceModRoot>$(ProjectDir)..\VPet-Simulator.Windows\mod\$(ModName)\</SourceModRoot>
	</PropertyGroup>
	<ItemGroup>
		<ModBinRoot Include="$(ProjectDir)..\VPet-Simulator.Windows\bin\x64\Debug\net8.0-windows\mod\$(ModName)\" />
		<ModBinRoot Include="$(ProjectDir)..\VPet-Simulator.Windows\bin\x86\Debug\net8.0-windows\mod\$(ModName)\" />
		<ModBinRoot Include="$(ProjectDir)..\VPet-Simulator.Windows\bin\x64\Release\net8.0-windows\mod\$(ModName)\" />
		<ModBinRoot Include="$(ProjectDir)..\VPet-Simulator.Windows\bin\x86\Release\net8.0-windows\mod\$(ModName)\" />
	</ItemGroup>
	<Target Name="DeployToModFolder" AfterTargets="Build">
		<!--
			VPet.Mod.LLMChat本体だけでなく、NAudio等このMODが実際に必要とする依存DLLも
			まとめてpluginフォルダへ配置する(本体側が同名アセンブリを未ロードのままでも動くように)。
			VPet-Simulator.Core/Windows.Interfaceは Private="false" のため出力に含まれない。
		-->
		<ItemGroup>
			<ModDeployFiles Include="$(TargetDir)*.dll" />
			<ModDeployFiles Include="$(TargetDir)*.pdb" />
		</ItemGroup>

		<!-- ソースツリー側(mklink.bat想定の正規配置場所) -->
		<MakeDir Directories="$(SourceModRoot)plugin" Condition="!Exists('$(SourceModRoot)plugin')" />
		<Copy SourceFiles="@(ModDeployFiles)" DestinationFolder="$(SourceModRoot)plugin" SkipUnchangedFiles="true" />

		<!-- 本体の実際のビルド出力フォルダ(既にビルド済みのものだけを対象) -->
		<ItemGroup>
			<ExistingModBinRoot Include="@(ModBinRoot)" Condition="Exists('%(Identity)..\..\')" />
		</ItemGroup>
		<MakeDir Directories="%(ExistingModBinRoot.Identity)plugin" Condition="!Exists('%(ExistingModBinRoot.Identity)plugin')" />
		<Copy SourceFiles="@(ModDeployFiles)" DestinationFolder="%(ExistingModBinRoot.Identity)plugin" SkipUnchangedFiles="true" Condition="'%(ExistingModBinRoot.Identity)' != ''" />
		<Copy SourceFiles="$(SourceModRoot)info.lps" DestinationFolder="%(ExistingModBinRoot.Identity)" SkipUnchangedFiles="true" Condition="'%(ExistingModBinRoot.Identity)' != '' and Exists('$(SourceModRoot)info.lps')" />
	</Target>

</Project>
