<Window x:Class="VPet.Mod.LLMChat.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM Chat 設定" Width="480" Height="640" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FFF3F6F9"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0290D5"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF0286C6"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FFE0E6EB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF2B333B"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8A94A0"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="HelperText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- トグルスイッチ風のCheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Grid.Column="0" Width="38" Height="20" CornerRadius="10"
                                    Background="#FFD7DEE6" VerticalAlignment="Center">
                                <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" Background="White"
                                        HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 角丸・フラットなButton -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 角丸・フォーカス時にアクセント色の枠になるTextBox / PasswordBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxはIsEditable(自由入力)のドロップダウン機能を壊さないよう、見た目のみ軽く調整する。
             実機で、環境によってはドロップダウン項目の文字色が背景色と衝突して見えなくなる報告があったため、
             ComboBox自体とドロップダウン項目(ComboBoxItem)の両方に明示的にFroreground/Backgroundを固定する -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容が多くても必ずスクロールで全項目に到達できるようにする(下部が見切れる問題への対策) -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,16,16,4">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="AIプロバイダー" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="プロバイダー" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Name="cbProvider" Margin="0,0,0,12" SelectionChanged="cbProvider_SelectionChanged">
                            <ComboBoxItem Content="Claude (Anthropic)" Tag="Claude"/>
                            <ComboBoxItem Content="ChatGPT (OpenAI)" Tag="OpenAI"/>
                            <ComboBoxItem Content="DeepSeek" Tag="DeepSeek"/>
                            <ComboBoxItem Content="Kimi (Moonshot AI)" Tag="Kimi"/>
                            <ComboBoxItem Content="カスタム (OpenAI互換API)" Tag="Custom"/>
                        </ComboBox>

                        <TextBlock Text="モデル名" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ComboBox Grid.Column="0" Name="tbModel" IsEditable="True"/>
                            <Button Grid.Column="1" Name="btnTestModel" Content="接続テスト" Width="88" Margin="8,0,0,0" Click="btnTestModel_Click"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Name="tbModelTestStatus" Style="{StaticResource HelperText}"/>
                        </Grid>

                        <StackPanel Name="spCustomEndpoint" Margin="0,0,0,12">
                            <TextBlock Text="カスタムエンドポイントURL (OpenAI互換 /chat/completions)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Name="tbCustomEndpoint"/>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Name="tbApiKeyLabel" Text="APIキー" Style="{StaticResource FieldLabel}" Margin="0"/>
                                <TextBlock Name="tbApiKeyStatus" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <PasswordBox Name="pbApiKey"/>
                            <TextBlock Style="{StaticResource HelperText}" Text="※空欄のまま保存すると、既存のAPIキーはそのまま保持されます"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="自発的な会話" Style="{StaticResource SectionHeader}"/>
                        <CheckBox Name="cbProactiveEnabled" Content="ときどき自分から話しかける" FontWeight="SemiBold"/>
                        <Grid Margin="28,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="間隔(秒)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Name="tbProactiveInterval" Margin="6,0,0,0" Padding="6,6"/>
                            <TextBlock Grid.Column="3" Text="確率(%)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Name="tbProactiveChance" Margin="6,0,0,0" Padding="6,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="会話の記憶" Style="{StaticResource SectionHeader}"/>
                        <CheckBox Name="cbMemoryEnabled" Content="会話を記憶する(アプリ再起動後も記憶を維持)" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource HelperText}" Margin="28,4,0,0"
                                Text="※古くなった会話はAIが自動で要約して覚えておきます。会話内容はこのPC上にファイルとして保存されます"/>
                        <StackPanel Orientation="Horizontal" Margin="28,10,0,0">
                            <Button Name="btnClearMemory" Content="記憶を消去" Width="100" Click="btnClearMemory_Click"/>
                            <TextBlock Name="tbMemoryStatus" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource HelperText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="音声読み上げ" Style="{StaticResource SectionHeader}"/>
                        <CheckBox Name="cbVoiceEnabled" Content="返信を読み上げる" FontWeight="SemiBold"/>

                        <Grid Margin="28,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="読み上げ方式" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Name="cbTtsProvider" Margin="6,0,0,0" SelectionChanged="cbTtsProvider_SelectionChanged">
                                <ComboBoxItem Content="VOICEVOX (ローカル)" Tag="Voicevox"/>
                                <ComboBoxItem Content="OpenAI TTS (クラウドAPI)" Tag="OpenAi"/>
                                <ComboBoxItem Content="A.I.VOICE (ローカル)" Tag="AiVoice"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="28,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="音量" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Name="sliderVoiceVolume" Margin="8,0,8,0" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" ValueChanged="sliderVoiceVolume_ValueChanged"/>
                            <TextBlock Grid.Column="2" Name="tbVoiceVolumeValue" VerticalAlignment="Center" Width="36"/>
                        </Grid>

                        <StackPanel Name="spVoicevoxSettings" Margin="28,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="エンドポイント" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Name="tbVoiceEndpoint" Margin="6,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="話者" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Name="cbVoiceSpeaker" Margin="6,0,6,0"/>
                                <Button Grid.Column="2" Name="btnFetchSpeakers" Content="一覧取得" Click="btnFetchSpeakers_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HelperText}" Text="※事前にVOICEVOXアプリ/ENGINEを起動しておく必要があります"/>
                        </StackPanel>

                        <StackPanel Name="spAiVoiceSettings" Margin="28,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="インストール先" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Name="tbAiVoiceInstallDir" Margin="6,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ボイス" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Name="cbAiVoicePreset" Margin="6,0,6,0"/>
                                <Button Grid.Column="2" Name="btnFetchAiVoicePresets" Content="一覧取得" Click="btnFetchAiVoicePresets_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HelperText}"
                                    Text="※事前にA.I.VOICE Editorをインストールしておく必要があります。インストール先は既定の場所を自動検出するため空欄のままで構いません。未起動の場合は自動で起動します(最大1分ほど)。起動時のウィンドウは自動的に最小化されます"/>
                        </StackPanel>

                        <StackPanel Name="spOpenAiTtsSettings" Margin="28,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="モデル" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Name="tbTtsOpenAiModel" Margin="6,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="音声" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Name="tbTtsOpenAiVoice" Margin="6,0,0,0"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HelperText}" Text="※音声名の例: alloy, echo, fable, onyx, nova, shimmer"/>
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Name="tbTtsOpenAiKeyLabel" Text="OpenAI TTS用 APIキー" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <TextBlock Name="tbTtsOpenAiKeyStatus" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <PasswordBox Name="pbTtsOpenAiKey" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource HelperText}" Text="※空欄のまま保存すると、既存のキーはそのまま保持されます。他の音声機能とは別のキーです"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="28,10,0,0">
                            <Button Name="btnTestVoice" Content="試し読み" Width="80" Click="btnTestVoice_Click"/>
                            <TextBlock Name="tbVoiceStatus" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource HelperText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="音声入力 (Whisper)" Style="{StaticResource SectionHeader}"/>
                        <CheckBox Name="cbVoiceInputEnabled" Content="マイクボタンで音声入力する" FontWeight="SemiBold"/>
                        <CheckBox Name="cbVoiceInputAutoSend" Content="認識結果を確認せず自動的に送信する" Margin="0,10,0,0"/>
                        <CheckBox Name="cbMicSoundEnabled" Content="マイクの開始/停止で音を鳴らす" Margin="0,10,0,0"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="モデル" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Name="tbVoiceInputModel" Margin="6,0,0,0"/>
                        </Grid>

                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="tbVoiceInputKeyLabel" Text="Whisper用 OpenAI APIキー" Style="{StaticResource FieldLabel}" Margin="0"/>
                                <TextBlock Name="tbVoiceInputKeyStatus" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <PasswordBox Name="pbVoiceInputKey" Margin="0,4,0,0"/>
                            <TextBlock Style="{StaticResource HelperText}" Text="※空欄のまま保存すると、既存のキーはそのまま保持されます。チャットのプロバイダー設定とは別のキーです"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="システムプロンプト" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,8" Text="キャラクター設定(任意)"/>
                        <TextBox Name="tbSystemPrompt" AcceptsReturn="True" TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" MinHeight="90" MaxHeight="180" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ボタンはスクロール外に固定し、内容がどれだけ増えても常に見える位置に表示する -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnCancel" Content="キャンセル" Width="90" Margin="0,0,8,0" Click="btnCancel_Click"/>
                <Button Name="btnSave" Content="保存" Width="90" Style="{StaticResource PrimaryButtonStyle}" Click="btnSave_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
