<Window x:Class="VPet.Mod.LLMChat.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM Chat 設定" Height="760" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="プロバイダー" Margin="0,0,0,4" FontWeight="Bold"/>
        <ComboBox Grid.Row="1" Name="cbProvider" Margin="0,0,0,10" SelectionChanged="cbProvider_SelectionChanged">
            <ComboBoxItem Content="Claude (Anthropic)" Tag="Claude"/>
            <ComboBoxItem Content="ChatGPT (OpenAI)" Tag="OpenAI"/>
            <ComboBoxItem Content="DeepSeek" Tag="DeepSeek"/>
            <ComboBoxItem Content="カスタム (OpenAI互換API)" Tag="Custom"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="モデル名" Margin="0,0,0,4" FontWeight="Bold"/>
        <TextBox Grid.Row="3" Name="tbModel" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4" Name="spCustomEndpoint" Margin="0,0,0,10">
            <TextBlock Text="カスタムエンドポイントURL (OpenAI互換 /chat/completions)" Margin="0,0,0,4" FontWeight="Bold"/>
            <TextBox Name="tbCustomEndpoint"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Name="tbApiKeyLabel" Text="APIキー" Margin="0,0,0,4" FontWeight="Bold"/>
            <PasswordBox Name="pbApiKey"/>
            <TextBlock Text="※空欄のまま保存すると、既存のAPIキーはそのまま保持されます" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <CheckBox Name="cbProactiveEnabled" Content="ときどき自分から話しかける" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                <TextBlock Text="間隔(分):" VerticalAlignment="Center"/>
                <TextBox Name="tbProactiveInterval" Width="50" Margin="6,0,16,0"/>
                <TextBlock Text="確率(%):" VerticalAlignment="Center"/>
                <TextBox Name="tbProactiveChance" Width="50" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,0,0,10">
            <CheckBox Name="cbVoiceEnabled" Content="返信を読み上げる" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                <TextBlock Text="読み上げ方式:" VerticalAlignment="Center"/>
                <ComboBox Name="cbTtsProvider" Width="180" Margin="6,0,0,0" SelectionChanged="cbTtsProvider_SelectionChanged">
                    <ComboBoxItem Content="VOICEVOX (ローカル)" Tag="Voicevox"/>
                    <ComboBoxItem Content="OpenAI TTS (クラウドAPI)" Tag="OpenAi"/>
                    <ComboBoxItem Content="A.I.VOICE (ローカル)" Tag="AiVoice"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Name="spVoicevoxSettings" Margin="20,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="エンドポイント:" VerticalAlignment="Center"/>
                    <TextBox Name="tbVoiceEndpoint" Width="180" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="話者:" VerticalAlignment="Center"/>
                    <ComboBox Name="cbVoiceSpeaker" Width="170" Margin="6,0,6,0"/>
                    <Button Name="btnFetchSpeakers" Content="一覧取得" Click="btnFetchSpeakers_Click"/>
                </StackPanel>
                <TextBlock Text="※事前にVOICEVOXアプリ/ENGINEを起動しておく必要があります" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Name="spAiVoiceSettings" Margin="20,6,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="インストール先:" VerticalAlignment="Center"/>
                    <TextBox Name="tbAiVoiceInstallDir" Width="180" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="ボイス:" VerticalAlignment="Center"/>
                    <ComboBox Name="cbAiVoicePreset" Width="170" Margin="6,0,6,0"/>
                    <Button Name="btnFetchAiVoicePresets" Content="一覧取得" Click="btnFetchAiVoicePresets_Click"/>
                </StackPanel>
                <TextBlock Text="※事前にA.I.VOICE Editorをインストールしておく必要があります。インストール先は既定の場所を自動検出するため空欄のままで構いません。未起動の場合は自動で起動します(最大1分ほど)。起動時のウィンドウは自動的に最小化されます" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Name="spOpenAiTtsSettings" Margin="20,6,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="モデル:" VerticalAlignment="Center"/>
                    <TextBox Name="tbTtsOpenAiModel" Width="150" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="音声:" VerticalAlignment="Center"/>
                    <TextBox Name="tbTtsOpenAiVoice" Width="150" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="※音声名の例: alloy, echo, fable, onyx, nova, shimmer" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Name="tbTtsOpenAiKeyLabel" Text="OpenAI TTS用 APIキー" FontWeight="Bold"/>
                    <PasswordBox Name="pbTtsOpenAiKey"/>
                    <TextBlock Text="※空欄のまま保存すると、既存のキーはそのまま保持されます。他の音声機能とは別のキーです" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                <Button Name="btnTestVoice" Content="試し読み" Width="80" Click="btnTestVoice_Click"/>
                <TextBlock Name="tbVoiceStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="11"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="8" Margin="0,0,0,10">
            <CheckBox Name="cbVoiceInputEnabled" Content="マイクボタンで音声入力する (OpenAI Whisper)" FontWeight="Bold"/>
            <CheckBox Name="cbVoiceInputAutoSend" Content="認識結果を確認せず自動的に送信する" Margin="20,6,0,0"/>
            <CheckBox Name="cbMicSoundEnabled" Content="マイクの開始/停止で音を鳴らす" Margin="20,6,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                <TextBlock Text="モデル:" VerticalAlignment="Center"/>
                <TextBox Name="tbVoiceInputModel" Width="140" Margin="6,0,0,0"/>
            </StackPanel>
            <StackPanel Margin="20,6,0,0">
                <TextBlock Name="tbVoiceInputKeyLabel" Text="Whisper用 OpenAI APIキー" FontWeight="Bold"/>
                <PasswordBox Name="pbVoiceInputKey"/>
                <TextBlock Text="※空欄のまま保存すると、既存のキーはそのまま保持されます。チャットのプロバイダー設定とは別のキーです" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="9" Margin="0,0,0,10">
            <TextBlock Text="システムプロンプト(キャラクター設定・任意)" Margin="0,0,0,4" FontWeight="Bold"/>
            <TextBox Name="tbSystemPrompt" AcceptsReturn="True" TextWrapping="Wrap"
                      VerticalScrollBarVisibility="Auto" Height="120" VerticalContentAlignment="Top"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnCancel" Content="キャンセル" Width="80" Margin="0,0,8,0" Click="btnCancel_Click"/>
            <Button Name="btnSave" Content="保存" Width="80" Click="btnSave_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
